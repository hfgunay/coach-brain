# Sunucunun dışarıdan görünen adresi (sonunda / yok). OAuth adresleri buna göre üretilir.
TUS_KOC_PUBLIC_URL=https://tus-koc.up.railway.app
# Kalıcı disk (Railway/Fly volume buraya bağlanır).
TUS_KOC_DATA_DIR=/data
# Virgülle ayrılmış davet kodları. Kayıt olurken biri istenir.
TUS_KOC_DAVET_KODLARI=uzun-rastgele-bir-kod
# Davetsiz herkese açmak için true (ticari sürümde ödeme akışı gelene kadar kapalı tutun).
TUS_KOC_ACIK_KAYIT=false
# Dönüş adresine izin verilen alan adları (varsayılan: claude.ai, claude.com, anthropic.com, chatgpt.com, openai.com, localhost).
# TUS_KOC_IZINLI_YONLENDIRMELER=claude.ai,claude.com,chatgpt.com
