# Public address of the server (no trailing /). OAuth addresses are built from it.
# On Railway this falls back to RAILWAY_PUBLIC_DOMAIN, so you can leave it out.
COACH_PUBLIC_URL=https://coach.up.railway.app
# Persistent disk (the Railway/Fly volume is mounted here).
COACH_DATA_DIR=/data
# Comma-separated invite codes. One is required to sign up.
COACH_INVITE_CODES=a-long-random-code
# true opens sign-up to everyone without an invite (keep false until payments exist).
COACH_OPEN_SIGNUP=false
# Domains allowed as OAuth redirect targets (default: claude.ai, claude.com, anthropic.com, chatgpt.com, openai.com, localhost).
# COACH_ALLOWED_REDIRECTS=claude.ai,claude.com,chatgpt.com
# Optional Telegram reminder bot (token from @BotFather). Empty means the bot is off.
# COACH_TELEGRAM_TOKEN=
# Defaults for new Telegram links. Each student changes their own with /time and /timezone.
# COACH_MORNING_TIME=09:00
# COACH_EVENING_TIME=22:00
# COACH_TIMEZONE=Europe/Istanbul
